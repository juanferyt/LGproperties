import { createClient } from '@/lib/supabase/server'
import { logout, updateBookingStatus } from './actions'
export default async function Admin(){
 const db=await createClient(); const {data:{user}}=await db.auth.getUser();
 const [{data:bookings},{data:properties},{data:payments}] = await Promise.all([
  db.from('bookings').select('id,code,check_in,check_out,total_amount,status,payment_status,properties(name),customers(full_name,email,phone)').order('created_at',{ascending:false}).limit(50),
  db.from('properties').select('id,name,status'), db.from('payments').select('amount,status')
 ]);
 const income=(payments||[]).filter(p=>p.status==='approved').reduce((a,p)=>a+Number(p.amount),0)
 return <main className="min-h-screen bg-ivory p-6 md:p-10"><div className="mx-auto max-w-7xl"><header className="flex flex-wrap justify-between gap-4"><div><p className="text-xs uppercase tracking-[.3em] text-gold">LG Properties</p><h1 className="mt-2 text-5xl">Panel administrativo</h1><p className="mt-2 text-black/55">{user?.email}</p></div><form action={logout}><button className="rounded-full border px-5 py-3">Cerrar sesión</button></form></header><section className="mt-10 grid gap-4 md:grid-cols-3">{[['Reservas',bookings?.length||0],['Propiedades',properties?.length||0],['Ingresos aprobados',`$${income.toLocaleString('es-CO')}`]].map(([a,b])=><div className="rounded-3xl bg-white p-6 shadow" key={String(a)}><p className="text-sm text-black/50">{a}</p><p className="mt-2 text-3xl">{b}</p></div>)}</section><section className="mt-8 overflow-x-auto rounded-3xl bg-white p-5 shadow"><h2 className="text-2xl">Reservas recientes</h2><table className="mt-5 min-w-full text-sm"><thead><tr className="text-left text-black/45"><th className="p-3">Código</th><th>Cliente</th><th>Propiedad</th><th>Fechas</th><th>Total</th><th>Pago</th><th>Estado</th></tr></thead><tbody>{(bookings||[]).map((b:any)=><tr key={b.id} className="border-t"><td className="p-3 font-semibold">{b.code}</td><td>{b.customers?.full_name}<br/><span className="text-xs text-black/45">{b.customers?.phone}</span></td><td>{b.properties?.name}</td><td>{b.check_in} — {b.check_out}</td><td>${Number(b.total_amount).toLocaleString('es-CO')}</td><td>{b.payment_status}</td><td><form action={updateBookingStatus} className="flex gap-2"><input type="hidden" name="id" value={b.id}/><select name="status" defaultValue={b.status} className="rounded-lg border p-2"><option value="pending">Pendiente</option><option value="confirmed">Confirmada</option><option value="cancelled">Cancelada</option><option value="completed">Completada</option></select><button className="rounded-lg bg-ink px-3 text-white">Guardar</button></form></td></tr>)}</tbody></table></section></div></main>
}
